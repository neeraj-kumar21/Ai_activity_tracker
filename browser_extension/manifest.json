{
    "manifest_version": 3,
    "name": "AI Activity Tracker",
    "version": "1.0",

    "permissions": [
        "tabs",
        "activeTab",
        "storage"
    ],

    "host_permissions": [
        "http://localhost:5000/*"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
              "content.js"
            ]
        }
    ],

    "icons": {
        "128": "icon.png"
    }
}